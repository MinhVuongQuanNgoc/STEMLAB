<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/app_background">

    <!-- Top Navigation Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar_background"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/btnBackFromHandFan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/top_bar_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Hand Fan Challenge"
            android:textColor="@color/top_bar_content"
            android:textSize="18sp"
            android:textStyle="bold" />

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvHandFanTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hand Fan Challenge"
                android:textColor="@color/text_highlight"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvHandFanInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Measure how air movement bends paper or cardboard. Enter the bend angle and material type to estimate the relative force."
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/etFanDesign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fan design / observation notes"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub" />

            <EditText
                android:id="@+id/etFanDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fan distance in cm, e.g. 30"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:inputType="numberDecimal"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etBendAngle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bend angle in degrees, e.g. 30"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:inputType="numberDecimal"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Material:"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <RadioGroup
                android:id="@+id/rgMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbThinPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thin printer paper (k = 0.05)"
                    android:textColor="@color/text_main" />

                <RadioButton
                    android:id="@+id/rbCardStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Standard card stock (k = 0.2)"
                    android:textColor="@color/text_main" />

                <RadioButton
                    android:id="@+id/rbThinCardboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thin cardboard (k = 0.5)"
                    android:textColor="@color/text_main" />

                <RadioButton
                    android:id="@+id/rbCorrugatedCardboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Corrugated cardboard (k = 2.5)"
                    android:textColor="@color/text_main" />

            </RadioGroup>

            <Button
                android:id="@+id/btnCalculateFanForce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate Estimated Force"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvFanResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Result will appear here."
                android:textColor="@color/text_highlight"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>