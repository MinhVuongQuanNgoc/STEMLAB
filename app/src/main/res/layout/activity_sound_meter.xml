<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/app_background">

    <!-- Top Navigation Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar_background"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/btnBackFromSoundMeter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/top_bar_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Sound Meter"
            android:textColor="@color/top_bar_content"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSoundTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sound Pollution Hunter"
                android:textColor="@color/text_highlight"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvSoundInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use this tool to compare classroom sound levels. The dB value is an estimated relative reading."
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvSoundLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/text_highlight"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSoundCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category: Not measured"
                        android:textColor="@color/text_sub"
                        android:textSize="18sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnStartSoundMeter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Measuring" />

            <Button
                android:id="@+id/btnStopSoundMeter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stop Measuring"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
