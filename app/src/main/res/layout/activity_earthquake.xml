<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/app_background">

    <!-- Top Navigation Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar_background"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/btnBackFromEarthquake"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/top_bar_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Earthquake Lab"
            android:textColor="@color/top_bar_content"
            android:textSize="18sp"
            android:textStyle="bold" />

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvEarthquakeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Earthquake-Resistant Structure"
                android:textColor="@color/text_highlight"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvEarthquakeInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Place the phone on the structure platform, gently shake the table or platform, and observe the movement strength. Lower peak movement means better vibration resistance."
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/etStructureDesign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Structure design notes, e.g. 10 folds + 4 pillars"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <TextView
                android:id="@+id/tvCurrentMovement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Movement: 0.00"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvPeakMovement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Peak Movement: 0.00"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvStabilityRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stability Rating: Not measured"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnStartEarthquakeTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Vibration Test"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnStopEarthquakeTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stop Vibration Test"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnResetEarthquakeTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset Peak Movement"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvEarthquakeResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Result will appear here."
                android:textColor="@color/text_highlight"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>