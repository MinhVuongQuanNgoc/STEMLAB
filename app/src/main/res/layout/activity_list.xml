<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/app_background">

    <!-- Top Navigation Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar_background"
        android:padding="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="STEM LAB"
            android:textColor="@color/top_bar_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="@color/top_bar_content" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/card_bg">

                <TextView
                    android:id="@+id/tvWelcomeTeam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="@string/welcome_team"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_highlight"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stemm_activities_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_highlight"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_challenge_subtitle"
                android:textSize="16sp"
                android:textColor="@color/text_sub"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnParachute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_parachute" />

            <Button
                android:id="@+id/btnSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_sound"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnFan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_fan"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnEarthquake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_earthquake"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnPerformance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_performance"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnReaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_reaction"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnBreathing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_breathing"
                android:layout_marginTop="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeaderboard"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/btn_view_leaderboard"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                app:icon="@drawable/ic_leaderboard"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_highlight"
                app:iconTint="@color/text_highlight"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
